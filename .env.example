# Copie para .env e ajuste os valores. Não compartilhe o arquivo .env.
PORT=3000
ADMIN_PASSWORD=troque-por-uma-senha-forte
WHATSAPP_NUMBER=5585999999999
DB_FILE=loja.db

# Uso local: HTTP funciona normalmente e o servidor aceita somente conexões locais.
NODE_ENV=development
HOST=127.0.0.1
TRUST_PROXY=false
PUBLIC_URL=

# Limites por IP para pedidos do site (janela de 15 minutos).
ORDER_RATE_WINDOW_MS=900000
ORDER_RATE_MAX_NEW=10
ORDER_RATE_MAX_ATTEMPTS=30
ORDER_RATE_MAX_IPS=5000

# Para publicar com HTTPS terminado por um proxy reverso, configure explicitamente:
# NODE_ENV=production
# TRUST_PROXY=127.0.0.1/32,::1/128
# PUBLIC_URL=https://sua-loja.example
# O proxy deve preservar Host e substituir X-Forwarded-For/Host/Proto.
# Proteja a porta interna para aceitar apenas o proxy. Nunca use TRUST_PROXY=true.
# Sem PUBLIC_URL, produção rejeita HTTP com 426; com a origem, GET/HEAD redirecionam.
# HOST=0.0.0.0 só é necessário se a infraestrutura exigir acesso externo à porta interna.
