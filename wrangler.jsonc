{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "purograo",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build:cloudflare" },
  "assets": {
    "directory": "./artifacts/cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "alias": { "node:sqlite": "./cloudflare/node-sqlite-unavailable.cjs" },
  "durable_objects": {
    "bindings": [{ "name": "SHOP_DB", "class_name": "ShopDatabase" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDatabase"] }],
  "vars": { "ENVIRONMENT": "production" },
  "observability": { "enabled": true }
}
